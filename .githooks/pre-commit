#!/bin/sh
# 仓库一致性门禁的薄入口。启用方式：git config core.hooksPath .githooks
#
# 跑哪些检查、每项为什么存在，见 repository_gates.py（catalog 真源，逐项理由
# 写在各 Gate 旁）；执行与汇总逻辑在 run_repository_gates.py。本文件只负责
# 定位自身并交给 runner——CI 的 gates-hooks 逐字执行本文件，连这层包装一起验证。
#
# 未通过时不要用 --no-verify 绕过。

set -u
# 找不到 python 时也要输出契约行：commit-cc-plugin 靠「[pre-commit] 未通过」识别拦截
command -v python >/dev/null 2>&1 || {
  echo "[pre-commit] 未通过。PATH 上找不到 python，门禁无法运行。"
  exit 1
}
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python "$HOOK_DIR/run_repository_gates.py"
