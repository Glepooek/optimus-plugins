{
  "mcpServers": {
    "avalonia-docs": {
      "type": "http",
      "url": "https://docs-mcp.avaloniaui.net/mcp"
    },
    "mastergo-magic-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mastergo/magic-mcp",
        "--token=<MASTERGO_TOKEN>",
        "--url=https://mastergo.com"
      ],
      "env": {
        "MG_MCP_TOKEN": "${MASTERGO_TOKEN}"
      }
    }
  }
}
